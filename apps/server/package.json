    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "5.8.2",
    "pino": "10.4.0",
    "postgres": "3.4.7",
    "tsx": "4.20.6",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "@types/ws": "8.18.1"
  }
