{
  "name": "capitalforge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "sim": "pnpm --filter @capitalforge/economy sim",
    "db:generate": "pnpm --filter @capitalforge/server db:generate",
    "db:migrate": "pnpm --filter @capitalforge/server db:migrate"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "fast-check": "4.3.0",
    "tsx": "4.20.6",
    "@types/node": "22.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
