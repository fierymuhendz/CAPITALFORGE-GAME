# Sunucu
PORT=2567
DATABASE_URL=postgres://capitalforge:capitalforge@localhost:5432/capitalforge
REDIS_URL=redis://localhost:6379
JWT_SECRET=degistir-beni
# Misafir oturum token'ının Redis'te yaşama süresi (saniye, varsayılan 7 gün)
SESSION_TTL_SECONDS=604800
# Reverse proxy arkasında true (istemci IP'si X-Forwarded-For'dan okunur, IP hız sınırı için)
# false | true | virgüllü IP/CIDR listesi (üretimde yalnızca web konteynerinin IP'si)
TRUST_PROXY=false
# Veritabanı bağlantı havuzu boyutu
DB_POOL_SIZE=10

# Web (istemciye açık değerler NEXT_PUBLIC_ ile başlar)
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

# Web: /api isteklerinin yönlendirileceği oyun sunucusu (build sırasında okunur)
GAME_SERVER_HTTP_URL=http://localhost:2567
