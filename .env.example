# Sunucu
PORT=2567
DATABASE_URL=postgres://capitalforge:capitalforge@localhost:5432/capitalforge
REDIS_URL=redis://localhost:6379
JWT_SECRET=degistir-beni
# Misafir oturum token'ının Redis'te yaşama süresi (saniye, varsayılan 7 gün)
SESSION_TTL_SECONDS=604800
# Reverse proxy arkasında true (istemci IP'si X-Forwarded-For'dan okunur, IP hız sınırı için)
# false | true | virgüllü IP/CIDR listesi (üretimde yalnızca web konteynerinin IP'si)
TRUST_PROXY=false
# Yeni hesapların alım-satım yapamadığı süre, saniye (0 = kapalı, 0-86400, varsayılan 600)
NEW_ACCOUNT_TRADE_DELAY_SECONDS=600
# Günlük düzeyi (pino): fatal|error|warn|info|debug
LOG_LEVEL=info
# İsteğe bağlı harici hata izleme (şimdilik kullanılmıyor, boş bırakın)
SENTRY_DSN=
# Veritabanı bağlantı havuzu boyutu
DB_POOL_SIZE=10

# Web (istemciye açık değerler NEXT_PUBLIC_ ile başlar)
# Yerelde ws://localhost:2567; üretimde göreli "/ws" (adres tarayıcı konumundan üretilir)
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

# Üretim (yalnızca GitHub Variables'ta tutulur, burada örnek):
# PUBLIC_DOMAIN=oyun.ornek.com   veya   1-2-3-4.sslip.io  (IP'deki noktalar tire)
# Üretimde REDIS_URL parolalı olmalı: redis://:PAROLA@redis:6379 (yoksa sunucu başlamaz).
# Parola sunucuda /opt/capitalforge/secrets/redis_password dosyasında üretilir, GitHub'a eklenmez.
# GitHub Secrets (production): BACKUP_PASSPHRASE = sunucu dışı yedek şifreleme parolası (backup.yml)

# Web: /api isteklerinin yönlendirileceği oyun sunucusu (build sırasında okunur)
GAME_SERVER_HTTP_URL=http://localhost:2567
