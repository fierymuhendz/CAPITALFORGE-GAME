# Sunucu
PORT=2567
DATABASE_URL=postgres://capitalforge:capitalforge@localhost:5432/capitalforge
REDIS_URL=redis://localhost:6379
# Oturum, IP karması ve 2FA anahtarları bundan türetilir (üretimde en az 32 karakter)
JWT_SECRET=degistir-beni
# Reverse proxy arkasında: false | true | virgüllü IP/CIDR listesi (üretimde yalnızca Caddy'nin IP'si)
TRUST_PROXY=false
# Günlük düzeyi (pino): fatal|error|warn|info|debug
LOG_LEVEL=info
# Çerezlerde Secure bayrağı (üretimde varsayılan açık)
SECURE_COOKIES=false
# Zamanlayıcı (üretim, sevkiyat, sözleşme taksitleri, bakım): açık/kapalı ve tarama aralığı (ms)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=5000
# Tek seferlik yönetici kurulum kodu (en az 16 karakter). Üretimde deploy.yml sunucuda üretir:
# /opt/capitalforge/secrets/admin_setup_code. Yalnızca karması veritabanında tutulur.
ADMIN_SETUP_CODE=
# Doluysa kayıt için bu davet kodu istenir (boş = herkes kayıt olabilir)
REGISTRATION_CODE=
# Yalnızca geliştirme/test: yönetici panelinden zamanı ileri alma (üretimde her zaman kapalı)
ALLOW_TIME_TRAVEL=false
# Hız sınırını kapat (yalnızca testler)
DISABLE_RATE_LIMIT=0

# Testler: entegrasyon testleri bu veritabanını silip yeniden kurar (adında "test" geçmeli)
TEST_DATABASE_URL=postgres://capitalforge:capitalforge@localhost:5432/capitalforge_test

# Web
# Tarayıcının canlı olaylar için bağlandığı adres; üretimde göreli "/ws"
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
# Web: /api isteklerinin yönlendirileceği oyun sunucusu (build sırasında okunur)
GAME_SERVER_HTTP_URL=http://localhost:2567

# Üretim (yalnızca GitHub Variables'ta tutulur, burada örnek):
# PUBLIC_DOMAIN=oyun.ornek.com   veya   1-2-3-4.sslip.io  (IP'deki noktalar tire)
# Üretimde REDIS_URL parolalı olmalı: redis://:PAROLA@redis:6379 (yoksa sunucu başlamaz).
# Parola sunucuda /opt/capitalforge/secrets/redis_password dosyasında üretilir, GitHub'a eklenmez.
# GitHub Secrets (production): DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, DEPLOY_KNOWN_HOSTS,
#   POSTGRES_PASSWORD, JWT_SECRET, BACKUP_PASSPHRASE
